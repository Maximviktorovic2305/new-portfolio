{
  "name": "maxim-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=low",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "check": "npm run format:check && npm run lint && npm run lint:fsd && npm run test && npm run audit && npm run build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fsd": "node scripts/check-fsd.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3015",
    "start": "serve dist --config ../serve.json --listen tcp://0.0.0.0:3015",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emailjs/browser": "4.4.1",
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "lucide-react": "1.55.0",
    "motion": "12.42.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "compression": "1.8.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
